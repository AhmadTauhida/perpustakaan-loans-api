# Salin file ini menjadi .env lalu isi nilainya
# Lihat: Supabase Dashboard > Project Settings > Data API / API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# Untuk backend ini cukup pakai publishable/anon key (responsi).
# Jika punya service_role key, isi juga agar bypass RLS:
SUPABASE_ANON_KEY=isi_dengan_publishable_key_anda
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
